[
  {
    "id": "private_key",
    "pattern": "-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----[\\s\\S]*?-----END(?: RSA | EC | OPENSSH )?PRIVATE KEY-----",
    "flags": "gi",
    "replacement": "[REDACTED:private_key]",
    "description": "PEM private key blocks"
  },
  {
    "id": "github_token",
    "pattern": "(?:ghp|gho|ghu|ghs|ghr|github_pat)_[a-zA-Z0-9]{10,}",
    "flags": "g",
    "replacement": "[REDACTED:github_token]",
    "description": "GitHub Personal Access Token and other GitHub tokens"
  },
  {
    "id": "slack_token",
    "pattern": "xox[bpras]-[a-zA-Z0-9\\-]{10,}",
    "flags": "g",
    "replacement": "[REDACTED:slack_token]",
    "description": "Slack bot/user/app tokens"
  },
  {
    "id": "aws_key",
    "pattern": "(?:AKIA|ABIA|ACCA|ASIA)[A-Z0-9]{16}",
    "flags": "g",
    "replacement": "[REDACTED:aws_key]",
    "description": "AWS access key IDs"
  },
  {
    "id": "api_key",
    "pattern": "(?:sk|pk|rk|ak)[_-][a-zA-Z0-9]{10,}",
    "flags": "g",
    "replacement": "[REDACTED:api_key]",
    "description": "Generic API keys (OpenAI sk-*, etc.)"
  },
  {
    "id": "bearer_token",
    "pattern": "(?:Bearer|Authorization)\\s+[a-zA-Z0-9\\-._~+/]+=*",
    "flags": "gi",
    "replacement": "[REDACTED:bearer_token]",
    "description": "Bearer tokens in Authorization headers"
  },
  {
    "id": "credential",
    "pattern": "(?:password|passwd|secret|token|api[_-]?key|apikey|database[_-]?url)\\s*[:=]\\s*\\S+",
    "flags": "gi",
    "replacement": "[REDACTED:credential]",
    "description": "Generic key=value credential assignments"
  },
  {
    "id": "url_credential",
    "pattern": "://[^:]+:[^@]+@[^\\s]+",
    "flags": "g",
    "replacement": "://[REDACTED:url_credential]@host",
    "description": "Credentials embedded in URLs (user:pass@host)"
  },
  {
    "id": "card_number",
    "pattern": "\\b(?:\\d{13,19}|\\d{4}(?:[ -]\\d{4}){3}[ -]\\d{1,3}|\\d{4}(?:[ -]\\d{4}){3}|\\d{4}(?:[ -]\\d{4}){2}[ -]\\d{1,4}|\\d{4}[ -]\\d{6}[ -]\\d{4,5})\\b",
    "flags": "g",
    "replacement": "[REDACTED:card_number]",
    "description": "Credit card numbers: 13-19 unseparated digits, or 4-digit groups (Amex 4-6-5, Diners 4-6-4). Two numbers joined by a hyphen are not a card (#4060)"
  },
  {
    "id": "abs_path",
    "pattern": "(?<![A-Za-z0-9_:/~.\\-])(?:file://)?/(?:(?:home|root|var|opt|etc|usr|tmp|mnt|srv|data|private|workspace|app|code|project|[Uu][Ss][Ee][Rr][Ss]|[Vv][Oo][Ll][Uu][Mm][Ee][Ss])(?:/[^\\s/\\\\'\"<>,;:!?()\\[\\]{}]+)+|(?:[^\\s/\\\\'\"<>,;:!?()\\[\\]{}]+/)*[^\\s/\\\\'\"<>,;:!?()\\[\\]{}]*\\.[A-Za-z][A-Za-z0-9_\\-]*)",
    "flags": "g",
    "replacement": "<PATH>",
    "description": "Filesystem paths: a known root, or a path whose last segment has a file extension. API routes such as /api/v1/users are left alone — they are corpus text, not a leak"
  },
  {
    "id": "windows_path",
    "pattern": "(?<![A-Za-z0-9_])[A-Za-z]:[\\\\/](?:[^\\s/\\\\'\"<>,;:!?()\\[\\]{}]+[\\\\/])*[^\\s/\\\\'\"<>,;:!?()\\[\\]{}]*",
    "flags": "g",
    "replacement": "<PATH>",
    "description": "Windows drive paths, with either separator"
  },
  {
    "id": "email",
    "pattern": "[A-Za-z0-9._%+\\-]+@[A-Za-z0-9\\-]+(?:\\.[A-Za-z0-9\\-]*)*\\.[A-Za-z]{2,}",
    "flags": "g",
    "replacement": "<REDACTED:email>",
    "description": "E-mail addresses. The top-level domain must be alphabetic, so an npm version spec (foo@1.2.3) is not a mail address"
  },
  {
    "id": "private_ip",
    "pattern": "(?<![0-9.])(?:10\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}|127\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}|169\\.254\\.\\d{1,3}\\.\\d{1,3}|172\\.(?:1[6-9]|2[0-9]|3[01])\\.\\d{1,3}\\.\\d{1,3}|192\\.168\\.\\d{1,3}\\.\\d{1,3}|100\\.(?:6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\\.\\d{1,3}\\.\\d{1,3})(?![0-9])",
    "flags": "g",
    "replacement": "<REDACTED:private_ip>",
    "description": "Private / non-routable IPv4: RFC1918, loopback, link-local, CGNAT. A public IP stays — the corpus is indexed by the error text and some faults are literally about an address."
  }
]
