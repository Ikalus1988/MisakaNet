# MisakaNet configuration example.
#
# Copy this file to `config.yaml` (git-ignored — never commit it) and edit. Every key below is
# read by code in this repository; a key that is not listed here is not read anywhere, and a
# key listed in the wrong place is silently ignored. `tests/test_config_example_is_honest.py`
# pins both directions.
#
#   search:  → scripts/search_config.py         (env override: MISAKA_SEARCH_*)
#   feishu:  → misakanet/scripts/draft_reminder.py (the only config.yaml reader there)

# ── Search scoring ───────────────────────────────────────────────────────────────────────────
# The three weights must sum to 1.0 (`SearchConfig.validate()` rejects anything within 0.01 of
# that). They are also overridable per-process by env vars, which win over this file.
#
# Note what is deliberately absent: `cross_encoder_weight` and `bm25_rerank_weight` exist on
# `SearchConfig` but the YAML loader does not apply them — only `MISAKA_SEARCH_CROSS_ENCODER_WEIGHT`
# and `MISAKA_SEARCH_BM25_RERANK_WEIGHT` do. Listing them here would be a key that reads as
# configuration and does nothing.
search:
  bm25_weight: 0.65        # keyword relevance (BM25)
  metadata_weight: 0.20    # domain / tag / title match
  baseline_weight: 0.15    # document baseline score
  rrf_k: 60                # Reciprocal Rank Fusion constant, >= 1 (for the vector hybrid)

# ── Feishu draft reminder (optional) ────────────────────────────────────────────────────────
# Without this key the reminder prints to stdout instead of posting: `draft_reminder.py` falls
# back, it does not fail.
feishu:
  webhook_url: ""
