# Local status snapshot (deliberately removed from repo in ed0316f9)
# Root-anchored on purpose: a bare `STATUS.md` also matches `docs/integrations/status.md`
# case-insensitively, hiding a file this repository tracks and publishes on macOS/Windows
# (case-insensitive filesystems). Guarded by tests/test_gitignore_index_agreement.py.
/STATUS.md

# Crawler flywheel metrics (local tracking)
data/crawler_flywheel.jsonl

# Hub runtime/generated artifacts (regenerable, not source-of-truth)
hub/storage/audit.jsonl
hub/storage/skill_index.json
# Hub orchestrator artifacts produced at startup (sqlite databases)
storage/

# Usage meter runtime data (local tracking)
data/usage_credits.jsonl
data/contribution_queue.jsonl

# local search quality feedback (issue #604)
data/search-feedback.jsonl

# Zero-result search gap logging (issue #1175)
data/search_gaps.jsonl
.private/

# Benchmark results (local only)
bench_results/
.aider*
.aider*
coverage.xml
data/lessons.db

# Accidentally-created root junk dirs (audit 2026-09-05, QW1/QW2): a failed
# multi-step shell command once created empty dirs named "1. scripts",
# "12. scripts/workers", and a full error string. Keep them out forever.
/[0-9]*. */
/The `*/

# Local audit working artifacts (multi-repo audit reports, execution logs)
.audit-reports-*/

# Local working artifacts — .codexignore has always listed these as local, but
# .gitignore did not, so a `git add -A` in a working tree that contained them
# committed 210 files (incl. an 8 MB vendored tool with its package-lock, which
# then produced Dependabot alerts for a tool this repo does not ship).
# Commit 29b098961 (2026-09-12); untracked again here.
.archify-tool/
# Root-anchored. As a bare `reports/` this also matched `docs/reports/`, so five tracked
# documents sat in a state where git ignored them and tracked them at the same time —
# which is how `misakanet/profile.json` (below) stayed tracked for months after being
# ignored, and how a stray `git add -A` keeps committing per-machine state. The rule's own
# comment says "Local audit working artifacts", i.e. the repository-root scratch directory.
/reports/
scripts/mhs_watch.py
scripts/mhs_watch_config.json
docs/agents/mhs-watch.md

# generated by packages/misakanet-setup/scripts/copy-hook.mjs at pack time
packages/misakanet-setup/hook/
packages/misakanet-setup/voice/
