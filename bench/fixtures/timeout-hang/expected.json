{
  "scenario": "timeout-hang",
  "description": "Script hangs in infinite loop",
  "difficulty": "edge_case",
  "expected_failure": {
    "type": "timeout",
    "message_pattern": "timeout|Timeout|killed|SIGKILL|SIGTERM",
    "exit_code": null
  },
  "fix": {
    "action": "add_timeout",
    "command": "timeout 5 python hang_script.py",
    "description": "Wrap the script with timeout command to kill after 5 seconds",
    "alternative_fix": {
      "action": "fix_code",
      "command": "python fixed_script.py",
      "description": "Use the fixed version with built-in timeout handling"
    }
  },
  "expected_outcome": "timeout",
  "timeout_seconds": 10
}
