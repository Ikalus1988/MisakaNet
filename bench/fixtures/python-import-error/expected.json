{
  "scenario": "python-import-error",
  "description": "Python script imports non-existent module",
  "difficulty": "medium",
  "expected_failure": {
    "type": "import_error",
    "message_pattern": "ModuleNotFoundError: No module named 'nonexistent_module_xyz_12345'",
    "exit_code": 1
  },
  "fix": {
    "action": "install_module",
    "command": "pip install nonexistent_module_xyz_12345",
    "description": "Install the missing module (will fail - module doesn't exist), or fix the import",
    "alternative_fix": {
      "action": "fix_import",
      "command": "sed -i 's/import nonexistent_module_xyz_12345/import json/' broken_script.py",
      "description": "Replace the invalid import with a valid standard library import"
    }
  },
  "expected_outcome": "success",
  "timeout_seconds": 60
}
