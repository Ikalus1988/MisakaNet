{
  "scenario": "dco-signoff",
  "description": "Commit missing DCO sign-off",
  "difficulty": "simple",
  "expected_failure": {
    "type": "dco",
    "message_pattern": "DCO.*sign.?off|Signed-off-by",
    "exit_code": 1
  },
  "fix": {
    "action": "amend_with_signoff",
    "command": "git commit --amend --signoff --no-edit",
    "description": "Amend the commit to add DCO sign-off"
  },
  "expected_outcome": "success",
  "timeout_seconds": 30
}
