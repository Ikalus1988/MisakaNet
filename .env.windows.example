# Windows Desktop App Configuration
# Refer to .env.windows for actual values

# ============================================================
# ⚠️  IMPORTANT: DSH_DESKTOP_APP_ID MUST MATCH DISTRIBUTION
# ============================================================
# 
# Issue #3093: NSIS installer upgrade fails when this value doesn't match
# the online distribution's appId. The registry key is computed as:
#   HKCU\Software\{UUID.v5(appId, "50e065bc-3134-11e6-9bab-38c9862bdaf3")}
# 
# If your build's appId differs from the installed version, NSIS will
# not detect the existing installation and will reject the upgrade.
#
# For DeepSeek distribution, use: com.deepseek.dsh
# DO NOT copy from this template blindly - verify against distribution!
#
# ============================================================
DSH_DESKTOP_APP_ID=com.deepseek.dsh

# Electron-builder configuration
ELECTRON_BUILDER_OUT_DIR=dist
NSIS_ENABLE=ELECTRON_BUILDER_NSIS_INSTALLER=1

# Output directory for Windows builds
WINDOWS_BUILD_OUTPUT=dist/win-unpacked

# Additional electron-builder settings
# See https://www.electron.build/configuration/windows
WINDOWS_BUILD_CONFIG_FILE=build/windows.config.js
