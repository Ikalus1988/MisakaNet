{
  "_comment": "Single source of truth for the client table on /install/ (issue #3640). The table is generated by scripts/generate_clients_table.py; `--check` fails when the page and this file drift apart. Do not edit the table in the page by hand — edit this file and re-run the generator.",
  "install_command": "npx @misaka-net/misakanet-setup",
  "verify_command": "npx @misaka-net/misakanet-setup --verify",
  "clients": [
    {
      "id": "claude",
      "name": "Claude Code",
      "writes": "~/.claude.json, ~/.claude/settings.json, ~/.claude/CLAUDE.md",
      "scope": "full",
      "reporting": "auto-with-consent",
      "account": "write-only",
      "docs": "/integrations/claude-code.md"
    },
    {
      "id": "codex",
      "name": "Codex CLI",
      "writes": "~/.codex/config.toml, ~/.codex/AGENTS.md",
      "scope": "full",
      "reporting": "auto-with-consent",
      "account": "write-only",
      "docs": null
    },
    {
      "id": "hermes",
      "name": "Hermes",
      "writes": "~/.hermes/config.yaml, ~/.hermes/SOUL.md",
      "scope": "full",
      "reporting": "auto-with-consent",
      "account": "write-only",
      "docs": null
    },
    {
      "id": "openclaw",
      "name": "OpenClaw",
      "writes": "AGENTS.md in each workspace",
      "scope": "full",
      "reporting": "auto-with-consent",
      "account": "write-only",
      "docs": null
    },
    {
      "id": "codewhale",
      "name": "codewhale",
      "writes": "~/.codewhale/mcp.json",
      "scope": "full",
      "reporting": "auto-with-consent",
      "account": "write-only",
      "docs": null
    },
    {
      "id": "cursor",
      "name": "Cursor",
      "writes": "~/.cursor/mcp.json",
      "scope": "mcp-only",
      "reporting": "mcp-only",
      "account": "no",
      "docs": "/integrations/cursor.md"
    },
    {
      "id": "gemini",
      "name": "Gemini CLI",
      "writes": "~/.gemini/settings.json",
      "scope": "mcp-only",
      "reporting": "mcp-only",
      "account": "no",
      "docs": "/integrations/gemini-cli.md"
    },
    {
      "id": "copilot",
      "name": "Copilot CLI",
      "writes": "~/.copilot/mcp-config.json",
      "scope": "mcp-only",
      "reporting": "mcp-only",
      "account": "no",
      "docs": "/integrations/copilot.md"
    },
    {
      "id": "opencode",
      "name": "OpenCode",
      "writes": "~/.config/opencode/opencode.json",
      "scope": "mcp-only",
      "reporting": "mcp-only",
      "account": "no",
      "docs": "/integrations/opencode.md"
    },
    {
      "id": "kiro",
      "name": "Kiro",
      "writes": "~/.kiro/settings/mcp.json",
      "scope": "mcp-only",
      "reporting": "mcp-only",
      "account": "no",
      "docs": "/integrations/kiro.md"
    },
    {
      "id": "mcode",
      "name": "MiniMax Code",
      "writes": "~/.minimax/plugins/misakanet/, ~/.minimax/AGENTS.md",
      "scope": "full",
      "reporting": "auto-with-consent",
      "account": "write-only",
      "docs": "/integrations/mcode.md"
    },
    {
      "id": "dsh",
      "name": "DeepSeek Harness",
      "writes": "$DSH_HOME/AGENTS.md (rules only; tools: dsh plugin --profile web add misakanet)",
      "scope": "rules-only",
      "reporting": "mcp-only",
      "account": "no",
      "docs": "/integrations/dsh.md"
    }
  ]
}
