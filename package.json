{
  "name": "misakanet",
  "version": "1.0.0",
  "description": "MisakaNet - An intelligent multi-agent system for distributed knowledge extraction and collaboration",
  "main": "dist/index.js",
  "bin": {
    "misakanet": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "type-check": "tsc --noEmit",
    "prepare": "npm run build",
    "postinstall": "node scripts/postinstall.js || true",
    "docker:build": "docker build -t misakanet .",
    "docker:run": "docker run -p 3000:3000 misakanet",
    "docker:compose": "docker-compose up -d",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "bump:version": "node scripts/bump-version.js",
    "changelog": "standard-version"
  },
  "keywords": [
    "ai",
    "agents",
    "llm",
    "misaka",
    "network"
  ],
  "author": "Ikalus1988",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ikalus1988/MisakaNet"
  },
  "bugs": {
    "url": "https://github.com/Ikalus1988/MisakaNet/issues"
  },
  "homepage": "https://github.com/Ikalus1988/MisakaNet#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@langchain/community": "^0.2.0",
    "@langchain/core": "^0.2.0",
    "@langchain/langgraph": "^0.0.25",
    "@langchain/openai": "^0.0.28",
    "@prisma/client": "^5.0.0",
    "@types/uuid": "^9.0.7",
    "axios": "^1.6.0",
    "better-sqlite3": "^9.4.3",
    "class-validator": "^0.14.0",
    "clsx": "^2.0.0",
    "cron": "^3.1.0",
    "dotenv": "^16.3.1",
    "eventemitter3": "^5.0.1",
    "express": "^4.18.2",
    "ioredis": "^5.3.2",
    "jsdom": "^24.0.0",
    "langchain": "^0.1.0",
    "reflect-metadata": "^0.2.1",
    "typeorm": "^0.3.17",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/cron": "^2.4.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsdom": "^21.1.4",
    "@types/node": "^20.10.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "prisma": "^5.0.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/*.test.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "json",
      "node"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/__tests__/**",
      "!src/**/*.d.ts"
    ],
    "coverageDirectory": "coverage",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    }
  }
}
