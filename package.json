{
  "name": "misakanet",
  "version": "1.0.0",
  "description": "MisakaNet - A modern desktop application",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "set ELECTRON_BUILDER_BINARIES_MIRROR=https://registry.npmmirror.com/-/binary/electron-builder-binaries/& set ELECTRON_BUILDER_CACHE=%USERPROFILE%\\.cache\\electron-builder && electron-builder --win nsis",
    "build:win:ci": "ELECTRON_BUILDER_BINARIES_MIRROR=https://registry.npmmirror.com/-/binary/electron-builder-binaries/ ELECTRON_BUILDER_CACHE=%USERPROFILE%\\.cache\\electron-builder electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.misakanet.app",
    "productName": "MisakaNet",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
