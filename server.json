{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Ikalus1988/misakanet",
  "description": "Failure-memory layer for coding agents: search verified debugging lessons by error text.",
  "repository": {
    "url": "https://github.com/Ikalus1988/MisakaNet",
    "source": "github"
  },
  "version": "2.28.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "misakanet",
      "version": "2.28.0",
      "transport": {
        "type": "stdio"
      },
      "runtime": {
        "command": "python3",
        "args": [
          "scripts/mcp_server.py"
        ]
      }
    }
  ]
}
