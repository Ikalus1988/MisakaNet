{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "signoff": "misakanet-bot <bot@misakanet.dev>",
  "packages": {
    ".": {
      "release-type": "python",
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features"
        },
        {
          "type": "fix",
          "section": "Bug Fixes"
        },
        {
          "type": "docs",
          "section": "Documentation"
        },
        {
          "type": "refactor",
          "section": "Refactoring"
        },
        {
          "type": "test",
          "section": "Tests"
        },
        {
          "type": "ci",
          "section": "CI/CD"
        },
        {
          "type": "lesson",
          "section": "Lessons"
        },
        {
          "type": "lessons",
          "section": "Lessons"
        }
      ],
      "extra-files": [
        "docs/index.html",
        "scripts/misakanet_cli.py",
        "workers/register-proxy-sw.js",
        {
          "type": "json",
          "path": "server.json",
          "jsonpath": "$..version"
        },
        {
          "type": "json",
          "path": "glama.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "docs/.well-known/agent.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "docs/.well-known/agent-card.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "docs/.well-known/mcp.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "docs/.well-known/glama.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$.packages[\"\"].version"
        },
        {
          "type": "json",
          "path": ".codex-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        "API.md",
        {
          "type": "json",
          "path": ".claude-plugin/plugin.json",
          "jsonpath": "$.version"
        }
      ],
      "exclude-paths": [
        "docs/maintainer"
      ]
    }
  }
}
