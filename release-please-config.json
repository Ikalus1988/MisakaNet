{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": true,
  "signoff": "misakanet-bot <bot@misakanet.dev>",
  "packages": {
    ".": {
      "release-type": "python",
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features"
        },
        {
          "type": "fix",
          "section": "Bug Fixes"
        },
        {
          "type": "docs",
          "section": "Documentation"
        },
        {
          "type": "refactor",
          "section": "Refactoring"
        },
        {
          "type": "test",
          "section": "Tests"
        },
        {
          "type": "ci",
          "section": "CI/CD"
        },
        {
          "type": "lesson",
          "section": "Lessons"
        },
        {
          "type": "lessons",
          "section": "Lessons"
        }
      ],
      "extra-files": [
        "docs/index.html",
        "scripts/misakanet_cli.py",
        "workers/register-proxy-sw.js",
        {
          "type": "json",
          "path": "server.json",
          "jsonpath": "$..version"
        },
        {
          "type": "json",
          "path": "glama.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "docs/.well-known/agent.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "docs/.well-known/agent-card.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "docs/.well-known/mcp.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "docs/.well-known/glama.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$.packages[\"\"].version"
        },
        {
          "type": "json",
          "path": ".codex-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        "API.md",
        {
          "type": "json",
          "path": ".claude-plugin/plugin.json",
          "jsonpath": "$.version"
        }
      ],
      "exclude-paths": [
        "docs/maintainer"
      ]
    },
    "packages/misakanet-setup": {
      "release-type": "node",
      "package-name": "@misaka-net/misakanet-setup",
      "component": "misakanet-setup",
      "include-component-in-tag": true,
      "tag-separator": "-",
      "initial-version": "0.6.0",
      "extra-files": [
        "/packages/misakanet-setup/bin/misakanet-setup.mjs",
        "/workers/misakanet-setup.test.mjs"
      ],
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features"
        },
        {
          "type": "fix",
          "section": "Bug Fixes"
        },
        {
          "type": "docs",
          "section": "Documentation"
        },
        {
          "type": "refactor",
          "section": "Refactoring"
        },
        {
          "type": "test",
          "section": "Tests"
        },
        {
          "type": "ci",
          "section": "CI/CD"
        }
      ]
    },
    "packages/fatal-guard": {
      "release-type": "node",
      "package-name": "@misaka-net/fatal-guard",
      "component": "fatal-guard",
      "include-component-in-tag": true,
      "tag-separator": "-",
      "initial-version": "0.3.0",
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features"
        },
        {
          "type": "fix",
          "section": "Bug Fixes"
        },
        {
          "type": "docs",
          "section": "Documentation"
        },
        {
          "type": "refactor",
          "section": "Refactoring"
        },
        {
          "type": "test",
          "section": "Tests"
        },
        {
          "type": "ci",
          "section": "CI/CD"
        }
      ]
    }
  }
}
