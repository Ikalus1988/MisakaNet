{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "signoff": "misakanet-bot <bot@misakanet.dev>",
  "packages": {
    ".": {
      "release-type": "python",
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features"
        },
        {
          "type": "fix",
          "section": "Bug Fixes"
        },
        {
          "type": "docs",
          "section": "Documentation"
        },
        {
          "type": "refactor",
          "section": "Refactoring"
        },
        {
          "type": "test",
          "section": "Tests"
        },
        {
          "type": "ci",
          "section": "CI/CD"
        }
      ],
      "extra-files": [
        "docs/index.html",
        "README.md",
        {
          "type": "json",
          "path": "server.json",
          "jsonpath": "$..version"
        },
        {
          "type": "json",
          "path": "glama.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "docs/.well-known/agent.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "docs/.well-known/agent-card.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "docs/.well-known/mcp.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
